{
  "name": "who-plays-tonight",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm data:refresh && next dev",
    "data:refresh": "node --experimental-strip-types scripts/refresh-nfl.mjs",
    "verify:export": "node --experimental-strip-types scripts/verify-export.mjs",
    "build": "pnpm data:refresh && next build",
    "build:github": "pnpm run build",
    "lint": "eslint . --ignore-pattern .next",
    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module",
  "packageManager": "pnpm@11.25.0"
}
